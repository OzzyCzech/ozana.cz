---
/** Availability badge on the homepage and contact page; change the status here only. */
---
<p class="availability">
	<span class="relative flex size-2" aria-hidden="true">
		<span class="absolute inline-flex size-full rounded-full bg-emerald-500 opacity-60 animate-ping motion-reduce:hidden"></span>
		<span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
	</span>
	Available for new projects
</p>

<style>
	@reference "../styles/global.css";

	.availability {
		@apply inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium text-slate-700;
		@apply bg-white/70 backdrop-blur-xl shadow-[0_1px_3px_rgba(15,23,42,0.06),0_8px_24px_rgba(15,23,42,0.06)];
	}
</style>
