---
import { ArrowUpRight } from "@lucide/astro";

export interface Props {
	href: string;
}
const {href} = Astro.props as Props;
---
<div class="mt-4">
	<a href={href} target="_blank" rel="noopener" class="link inline-flex items-center gap-1 font-medium text-slate-900">
		<slot/>
		<ArrowUpRight class="size-4 text-slate-500" aria-hidden="true"/>
		<span class="sr-only">(opens in a new tab)</span>
	</a>
</div>
