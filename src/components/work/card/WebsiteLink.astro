---
import { SquareArrowOutUpRight } from "@lucide/astro";


export interface Props {
	href: string;
}
const {href} = Astro.props as Props;
---
<div class="mt-4">
	<a href={href} target="_blank" rel="noopener" class="btn-ghost">
		<slot/>
		<SquareArrowOutUpRight class="size-4" aria-hidden="true"/>
	</a>
</div>