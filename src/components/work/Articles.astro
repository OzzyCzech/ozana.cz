---
import { ArrowUpRight } from "@lucide/astro";
import { fetchArticles } from "../../lib/zdrojak";

/** Newest articles from the Zdroják author feed; an even count keeps the two-column grid balanced. */
const articles = (await fetchArticles()).slice(0, 12);

const NEW_FOR_DAYS = 60;
const isNew = (published: string) => Date.now() - Date.parse(published) < NEW_FOR_DAYS * 24 * 60 * 60 * 1000;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
/** "3 Sep 2026": always a three-letter month, Intl gives "Sept" for September. */
const formatDate = (published: string) => {
	const date = new Date(published);
	return `${date.getUTCDate()} ${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
};
---
<section class="mt-12 pt-12 border-t border-slate-200">

	<div class="flex items-baseline justify-between gap-4 mb-2">
		<h2 class="section-title">Latest Articles</h2>
		<span class="text-sm text-slate-600">on <a href="https://zdrojak.cz/" target="_blank" rel="noopener" class="link">Zdroják.cz</a></span>
	</div>

	<ol class="grid grid-cols-1 md:grid-cols-2 md:gap-x-10">
		{articles.map(({title, url, published}) => (
			<li class="border-b border-slate-900/10">
				<a href={url} target="_blank" rel="noopener" class="article-link group">
					<time datetime={published} class="article-date">{formatDate(published)}</time>
					<span class="flex-1 leading-snug">
						{title}
						{isNew(published) && <span class="badge badge-new ml-2">New</span>}
					</span>
					<ArrowUpRight class="size-4 shrink-0 mt-1 text-slate-400 opacity-0 -translate-x-1 transition group-hover:opacity-100 group-hover:translate-x-0 motion-reduce:transition-none" aria-hidden="true"/>
				</a>
			</li>
		))}
	</ol>

	<div class="text-center mt-8">
		<a href="https://zdrojak.cz/autori/roman-ozana/" target="_blank" rel="noopener" class="btn btn-xs">
			All articles on Zdroják.cz
		</a>
	</div>

</section>

<style>
	@reference "../../styles/global.css";

	.article-link {
		@apply flex items-start gap-4 py-3.5 -mx-2 px-2 rounded-lg;
		@apply text-sm font-medium text-slate-800;
		@apply hover:no-underline hover:bg-white/60 hover:text-primary transition-colors;
	}

	.article-date {
		@apply shrink-0 w-24 pt-0.5 font-mono text-xs text-slate-600 tabular-nums;
	}

	.badge-new {
		@apply px-1.5 py-0 text-[0.65rem] font-semibold uppercase tracking-wide align-middle;
		@apply bg-primary text-white;
	}
</style>
