---
import { Newspaper } from "@lucide/astro";
import { fetchArticles } from "../../lib/zdrojak";

/** Newest articles from the Zdroják author feed; an even count keeps the two-column grid full. */
const articles = (await fetchArticles()).slice(0, 12);
---
<section class="mt-12 pt-12 border-t border-slate-200">

	<h2 class="section-title mb-4">Latest Articles</h2>

	<ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
		{articles.map(({title, url, published}) => (
			<li>
				<a href={url} target="_blank" rel="noopener" class="article-link" title={new Date(published).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'})}>
					<Newspaper class="size-4 shrink-0 text-slate-400"/>
					<span>{title}</span>
				</a>
			</li>
		))}
	</ul>

	<div class="text-center mt-8">
		<a href="https://zdrojak.cz/autori/roman-ozana/" target="_blank" rel="noopener" class="btn btn-xs">
			All articles on Zdroják.cz
		</a>
	</div>

</section>

<style>
	@reference "../../styles/global.css";

	.article-link {
		@apply flex items-center gap-3 px-4 py-3;
		@apply rounded-lg border border-slate-200;
		@apply text-sm font-medium text-slate-700;
		@apply hover:no-underline hover:bg-slate-50 hover:text-primary hover:border-slate-300;
		@apply transition-colors;
	}
</style>
