---
import {
	Apple,
	Astro as AstroIcon,
	Biomejs,
	Bun,
	Claude,
	ClaudeCode,
	Codex,
	Css,
	Docker,
	Git,
	GnuMake,
	Html,
	Js,
	Linux,
	Mariadb,
	Mongodb,
	Nette,
	Nodejs,
	Npm,
	Openai,
	Php,
	PhpStorm,
	PhpUnit,
	Puppeteer,
	React,
	Redis,
	Svelte,
	Symfony,
	Tailwind,
	TypeScript,
	Vite,
	Vitest,
	Vue,
	Webpack,
	Wordpress,
	ZendFramework
} from "@wticons/astro";

/** Grouped by how much each matters today, most important first; within a group, current before legacy. */
const groups = [
	{
		title: 'AI',
		items: [
			{icon: Claude, label: 'Claude', href: 'https://claude.ai'},
			{icon: ClaudeCode, label: 'Claude Code', href: 'https://claude.com/product/claude-code'},
			{icon: Openai, label: 'OpenAI', href: 'https://openai.com'},
			{icon: Codex, label: 'Codex', href: 'https://openai.com/codex'}
		],
	},
	{
		title: 'Languages',
		items: [
			{icon: Php, label: 'PHP', href: 'https://www.php.net'},
			{icon: TypeScript, label: 'TypeScript', href: 'https://www.typescriptlang.org'},
			{icon: Js, label: 'JavaScript', href: 'https://developer.mozilla.org/en-US/docs/Web/JavaScript'},
			{icon: Html, label: 'HTML5', href: 'https://developer.mozilla.org/en-US/docs/Web/HTML'},
			{icon: Css, label: 'CSS3', href: 'https://developer.mozilla.org/en-US/docs/Web/CSS'}
		],
	},
	{
		title: 'Backend',
		items: [
			{icon: Nette, label: 'Nette', href: 'https://nette.org'},
			{icon: Nodejs, label: 'Node.js', href: 'https://nodejs.org'},
			{icon: Bun, label: 'Bun', href: 'https://bun.sh'},
			{icon: Symfony, label: 'Symfony', href: 'https://symfony.com'},
			{icon: ZendFramework, label: 'Zend', href: 'https://framework.zend.com/'}
		],
	},
	{
		title: 'Frontend',
		items: [
			{icon: Vue, label: 'Vue.js', href: 'https://vuejs.org'},
			{icon: Tailwind, label: 'Tailwind', href: 'https://tailwindcss.com'},
			{icon: AstroIcon, label: 'Astro', href: 'https://astro.build'},
			{icon: React, label: 'React', href: 'https://react.dev'},
			{icon: Svelte, label: 'Svelte', href: 'https://svelte.dev'},
		],
	},
	{
		title: 'Databases',
		items: [
			{icon: Mongodb, label: 'MongoDB', href: 'https://www.mongodb.com'},
			{icon: Mariadb, label: 'MariaDB', href: 'https://mariadb.org'},
			{icon: Redis, label: 'Redis', href: 'https://redis.io'}
		],
	},
	{
		title: 'Testing',
		items: [
			{icon: Vitest, label: 'Vitest', href: 'https://vitest.dev/'},
			{icon: PhpUnit, label: 'PHPUnit', href: 'https://phpunit.de'},
			{icon: Puppeteer, label: 'Puppeteer', href: 'https://pptr.dev'},
		],
	},
	{
		title: 'Build & Tooling',
		items: [
			{icon: Vite, label: 'Vite', href: 'https://vite.dev'},
			{icon: Biomejs, label: 'Biome', href: 'https://biomejs.dev'},
			{icon: Npm, label: 'NPM', href: 'https://www.npmjs.com/'},
			{icon: GnuMake, label: 'Make', href: 'https://www.gnu.org/software/make/'},
			{icon: Webpack, label: 'Webpack', href: 'https://webpack.js.org'},
		],
	},
	{
		title: 'Platforms & Tools',
		items: [
			{icon: Docker, label: 'Docker', href: 'https://www.docker.com'},
			{icon: Git, label: 'Git', href: 'https://git-scm.com'},
			{icon: Linux, label: 'Linux', href: 'https://www.linux.org'},
			{icon: Apple, label: 'macOS', href: 'https://www.apple.com/os/macos/'},
			{icon: PhpStorm, label: 'PhpStorm', href: 'https://www.jetbrains.com/phpstorm/'},
			{icon: Wordpress, label: 'WordPress', href: 'https://wordpress.org'}
		],
	},
];
---
<section class="break-before-page">
	<h2 class="section-title mb-6">Tech I Love Working With</h2>

	<div class="grid gap-10 sm:grid-cols-2">
		{groups.map(({title, items}) => (
			<article>
				<h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider mb-3">{title}</h3>
				<div class="flex flex-wrap gap-4 *:flex *:flex-col *:items-center *:gap-1">
					{items.map(({icon: Icon, label, href}) => (
						<a href={href} target="_blank" rel="noopener">
							<Icon class="size-14"/>
							<small class="text-xs text-slate-600">{label}</small>
						</a>
					))}
				</div>
			</article>
		))}
	</div>
</section>
