---
import { Menu, X} from '@lucide/astro';
import GithubIcon from '../icons/github.svg';

const links = [
	{href: '/', label: 'Home'},
	{href: '/projects/', label: 'Projects'},
	{href: '/resume/', label: 'Resume'},
	{href: '/contact/', label: 'Contact'},
];

const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
---

<!-- ::before is a soft white fade that only shows once the page has scrolled, so content doesn't peek raw around the bar -->
<header id="header" class="sticky top-0 z-40 w-full px-3 sm:px-4 pt-3 print:hidden before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:-z-10 before:h-[calc(100%+1.5rem)] before:bg-linear-to-b before:from-white/80 before:to-transparent before:opacity-0 before:transition-opacity before:duration-300 data-scrolled:before:opacity-100">
<!-- glass lives on ::before so this box is not a backdrop root and the mobile menu can blur the page itself -->
<div class="relative mx-auto max-w-screen-lg before:absolute before:inset-0 before:-z-10 before:rounded-full before:border before:border-white/40 before:bg-white/45 before:shadow-[0_18px_60px_rgba(15,23,42,0.12)] before:backdrop-blur-[40px] before:backdrop-saturate-150">
	<nav aria-label="Main" class="flex items-center justify-between h-16 pl-6 pr-3">
		<a href="/" class="text-[0.95rem] font-semibold tracking-tight text-slate-900 hover:no-underline hover:text-primary transition-colors">Roman Ožana</a>

		<div class="hidden lg:flex items-center gap-1">
			{links.map(({href, label}) => <a href={href} class="nav-link" aria-current={current(href)}>{label}</a>)}
			<a href="https://github.com/OzzyCzech/" target="_blank" rel="noopener" class="nav-icon">
				<GithubIcon class="size-4" aria-hidden="true"/>
				<span class="sr-only">GitHub</span>
			</a>
		</div>

		<button
			class="p-2.5 rounded-full hover:bg-slate-900/[0.04] transition-colors lg:hidden"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
			id="menu-toggle"
		>
			<Menu class="size-5" id="icon-menu"/>
			<X class="size-5 hidden" id="icon-close"/>
		</button>
	</nav>

	<nav id="mobile-menu" aria-label="Mobile navigation" class="hidden lg:hidden absolute inset-x-0 top-full mt-2 z-50 p-2 rounded-3xl border border-white/40 bg-white/60 backdrop-blur-[40px] backdrop-saturate-150 shadow-[0_24px_70px_rgba(15,23,42,0.16)]">
		<div class="flex flex-col">
			{links.map(({href, label}) => <a href={href} class="mobile-nav-link" aria-current={current(href)}>{label}</a>)}
			<hr class="my-1.5 mx-4 border-slate-900/10"/>
			<a href="https://github.com/OzzyCzech/" target="_blank" rel="noopener" class="mobile-nav-link inline-flex items-center gap-2.5">
				<GithubIcon class="size-4" aria-hidden="true"/> GitHub
			</a>
		</div>
	</nav>
</div>
</header>

<style>
	@reference "tailwindcss";

	.nav-link {
		@apply px-4 py-2 text-sm font-semibold text-slate-900 rounded-full hover:no-underline hover:bg-slate-900/[0.04] transition-colors;
	}

	.nav-link[aria-current="page"] {
		@apply bg-slate-900/[0.05];
	}

	.nav-icon {
		@apply p-2.5 text-slate-900 rounded-full hover:no-underline hover:bg-slate-900/[0.04] transition-colors;
	}

	.mobile-nav-link {
		@apply px-4 py-3 text-base font-semibold text-slate-900 rounded-2xl hover:no-underline hover:bg-slate-900/[0.04] transition-colors;
	}

	.mobile-nav-link[aria-current="page"] {
		@apply bg-slate-900/[0.05];
	}

	#mobile-menu:not(.hidden) {
		animation: menu-in 160ms ease-out;
	}

	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#mobile-menu:not(.hidden) {
			animation: none;
		}
	}

</style>

<script>
	const header = document.getElementById('header');
	const toggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const iconMenu = document.getElementById('icon-menu');
	const iconClose = document.getElementById('icon-close');

	const setOpen = (open: boolean) => {
		mobileMenu?.classList.toggle('hidden', !open);
		iconMenu?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	const isOpen = () => !mobileMenu?.classList.contains('hidden');

	toggle?.addEventListener('click', () => setOpen(!isOpen()));

	document.addEventListener('click', (e) => {
		if (!toggle?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) setOpen(false);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen()) {
			setOpen(false);
			toggle?.focus();
		}
	});

	const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
	window.addEventListener('scroll', onScroll, {passive: true});
	onScroll();
</script>
