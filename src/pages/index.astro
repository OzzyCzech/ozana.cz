---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Avatar from "../components/Avatar.astro";
import { ArrowRight } from "@lucide/astro";
import RoleRotator from "../components/RoleRotator.astro";
---

<Layout
	title="Ing. Roman Ožana – Full-Stack Developer"
	description="Hey, I'm Roman Ožana, a passionate Full-Stack Developer specializing in building robust web applications and services. Explore my projects and get in touch!">

	<Header/>

	<main id="main" class="container mx-auto p-4 self-center align-center">

		<div class="flex flex-wrap justify-center my-10">
			<Avatar/>
		</div>

		<article class="text-center">

			<p class="availability mb-5">
				<span class="relative flex size-2" aria-hidden="true">
					<span class="absolute inline-flex size-full rounded-full bg-emerald-500 opacity-60 animate-ping motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
				</span>
				Available for new projects
			</p>

			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-1.5">
				Hey, I'm Roman.
			</h1>

			<RoleRotator/>

			<p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-600 text-pretty">
				I build web applications and services in Prague, since 2009.
				Co-founder of <a href="https://testomato.com" target="_blank" rel="noopener" class="link">Testomato</a>,
				long-time developer of <a href="https://zdrojak.cz" target="_blank" rel="noopener" class="link">Zdroják.cz</a> and
				author of a few dozen <a href="https://github.com/OzzyCzech" target="_blank" rel="noopener" class="link">open-source packages</a>. I like small, efficient teams and products that stay simple.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/contact/" class="btn btn-lg">
					Get in touch
					<ArrowRight class="size-4" aria-hidden="true"/>
				</a>
				<a href="/resume/" class="btn-ghost">View resume</a>
			</div>
		</article>

	</main>

	<Footer/>
</Layout>

<style>
	@reference "../styles/global.css";

	.availability {
		@apply inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium text-slate-700;
		@apply bg-white/70 backdrop-blur-xl shadow-[0_1px_3px_rgba(15,23,42,0.06),0_8px_24px_rgba(15,23,42,0.06)];
	}
</style>
