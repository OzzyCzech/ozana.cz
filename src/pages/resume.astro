---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from "astro:assets";
import qr from "../components/resume/contact.svg";
import WorkExperiences from "../components/resume/WorkExperiences.astro";
import OpenSource from "../components/resume/OpenSource.astro";
import TechStack from "../components/resume/TechStack.astro";
import Headline from "../components/resume/Headline.astro";
import Language from "../components/resume/Language.astro";
import DrivingLicense from "../components/resume/DrivingLicense.astro";
import Education from "../components/resume/Education.astro";
import { ArrowRight, Download } from "@lucide/astro";

const years = new Date().getFullYear() - 2009;
const pdfName = `Resume - Ing. Roman Ožana - ${new Date().getFullYear()}.pdf`;
---

<Layout
	title="Resume – Ing. Roman Ožana"
	description="Resume of Roman Ožana, Full-Stack Developer from Prague building for the web since 2009 – work experience, tech stack, education and languages.">
	<Header/>

	<main id="main" class="container px-4 mx-auto max-w-screen-lg">
		<div class="py-10 md:py-16 lg:py-20 text-center">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">Ing. Roman Ožana</h1>
			<p class="mt-3 text-muted-foreground text-lg cursor-pointer select-none print:hidden" id="subtitle" role="button" tabindex="0">Building things for the web since 2009</p>
			<p class="mt-3 text-muted-foreground text-lg hidden print:block">Building things for the web since 2009</p>

			<!-- on-screen summary; the print version has its own in Headline -->
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 text-pretty print:hidden">
				Full-stack developer from Prague with over {years} years of building web applications and services.
				Co-founder and main developer of <a href="https://testomato.com" target="_blank" rel="noopener" class="link">Testomato</a> and long-time
				lead developer of <a href="https://zdrojak.cz" target="_blank" rel="noopener" class="link">Zdroják.cz</a>, working mostly in PHP and TypeScript.
				I like small, efficient teams and products that stay simple.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3 print:hidden">
				<a href="/cv.pdf" download={pdfName} class="btn btn-lg">
					<Download class="size-4" aria-hidden="true"/>
					Download PDF
				</a>
				<a href="/contact/" class="btn-ghost">
					Get in touch
					<ArrowRight class="size-4" aria-hidden="true"/>
				</a>
			</div>
		</div>

		<script>
			const lines = [
				'Building things for the web since 2009',
				'Breaking things on the web since 2009',
				'Googling Stack Overflow since 2009',
				'Mass-producing bugs since 2009',
				'Closing 1000 browser tabs since 2009',
				'It works on my local since 2009',
				'Turning coffee into code since 2009',
				'Fighting CSS since 2009',
				'git push --force since 2009',
				'rm -rf node_modules since 2009',
			];
			let i = 0;
			const el = document.getElementById('subtitle');
			function cycle() {
				if (!el) return;
				i = (i + 1) % lines.length;
				el.style.opacity = '0';
				setTimeout(() => {
					el.textContent = lines[i] ?? '';
					el.style.opacity = '1';
				}, 150);
			}
			el?.addEventListener('click', cycle);
			el?.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					cycle();
				}
			});
			if (el) el.style.transition = 'opacity 150ms ease';
		</script>

		<div class="space-y-16 pb-16">
			<Headline/>
			<WorkExperiences/>
			<OpenSource/>
			<TechStack/>

			<div class="grid gap-16 md:gap-12 md:grid-cols-2">
				<Education/>
				<div class="space-y-12">
					<Language/>
					<DrivingLicense/>
				</div>
			</div>
		</div>

		<section class="hidden print:block break-before-page">
			<div class="grid min-h-screen align-center">
				<div class="self-center">
					<Image src={qr} alt="Roman Ožana" class="w-6/12 mx-auto"/>
				</div>
			</div>
		</section>

		<div class="text-center my-12 print:hidden">
			<a href="/cv.pdf" download={pdfName} class="btn btn-lg">
				<Download class="size-4" aria-hidden="true"/>
				Download as PDF
			</a>
		</div>
	</main>
	<Footer/>
</Layout>
