---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Mail, MapPin, Phone, Bookmark } from '@lucide/astro';
---
<Layout
	title="Contact – Ing. Roman Ožana"
	description="Get in touch with Roman Ožana, Full-Stack Developer based in Prague – e-mail, phone, vCard and social profiles.">

	<Header/>

	<main id="main" class="max-w-xl mx-auto px-4 py-12 md:py-24 flex flex-col items-center justify-center">

		<div class="mb-10 text-center">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-3">
				Let's get in touch
			</h1>
			<p class="text-muted-foreground text-lg">Feel free to reach out anytime.</p>
		</div>

		<div class="flex flex-col gap-6 w-full">
			<a href="mailto:roman@ozana.cz" class="contact-card hover:bg-white/85 hover:no-underline">
				<div class="text-slate-700">
					<Mail class="size-5"/>
				</div>
				<div>
					<p class="text-sm text-slate-600">Email</p>
					<p class="font-semibold text-slate-900">roman@ozana.cz</p>
				</div>
			</a>

			<a href="tel:+420605783455" class="contact-card hover:bg-white/85 hover:no-underline">
				<div class="text-slate-700">
					<Phone class="size-5"/>
				</div>
				<div>
					<p class="text-sm text-slate-600">Phone</p>
					<p class="font-semibold text-slate-900">+420 605 783 455</p>
				</div>
			</a>

			<div class="contact-card">
				<div class="text-slate-700">
					<MapPin class="size-5"/>
				</div>
				<div>
					<p class="text-sm text-slate-600">Location</p>
					<p class="font-semibold text-slate-900">
						Prague,
						Czech Republic
						
					</p>
				</div>
			</div>
		</div>

		<div class="mt-8 text-center">
			<a
				href="/ozana.vcf"
				class="btn"
				download="Roman Ožana.vcf">
				<Bookmark class="size-4"/>
				Add to Contacts
			</a>
		</div>

		<p class="mt-6 text-sm text-slate-600 text-center">
			IN:&nbsp;<a href="https://www.rzp.cz/verejne-udaje/cs/udaje/vyber-subjektu;ico=87098504" title="Registration number" target="_blank" rel="noopener" class="link text-slate-600 hover:text-slate-900">87098504</a>
		</p>

	</main>
	<Footer/>
</Layout>

<style>
	@reference "../styles/global.css";

	/* glass cards, same language as the floating header and mobile menu */
	.contact-card {
		@apply flex items-center gap-4 px-5 py-4 rounded-3xl;
		@apply border border-white/60 bg-white/60 backdrop-blur-xl;
		@apply shadow-[0_18px_60px_rgba(15,23,42,0.06)] transition-colors;
	}
</style>
